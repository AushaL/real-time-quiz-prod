# Clerk publishable key (same instance as the backend CLERK_SECRET_KEY).
VITE_CLERK_PUBLISHABLE_KEY=

# Local development. In production point these at the backend Vercel project,
# for example https://quiz-api.vercel.app.
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Socket.IO path. Locally the NestJS server serves /socket.io. On Vercel the
# backend exposes api/socket-io.js at /api/socket-io, so set
# VITE_SOCKET_PATH=/api/socket-io/socket.io there.
VITE_SOCKET_PATH=/socket.io
