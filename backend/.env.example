NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Local Docker Compose (docker-compose.yml)
DATABASE_URL=postgresql://quiz:quiz@localhost:5432/quiz?schema=public
DIRECT_URL=postgresql://quiz:quiz@localhost:5432/quiz?schema=public
TEST_DATABASE_URL=postgresql://quiz:quiz@localhost:5432/quiz_test?schema=public

# Supabase (production). The app runtime uses the pooled URL; Prisma
# migrate/seed use DIRECT_URL. Both need sslmode=require.
# Transaction pooler (port 6543) for the serverless runtime:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Direct connection (port 5432) or the session pooler for migrations:
# DIRECT_URL=postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require

REDIS_URL=redis://localhost:6379
# Quiz read cache TTL (seconds); writes invalidate it immediately.
QUIZ_CACHE_TTL_SECONDS=60

# Multiplayer
# Keep /socket.io locally and on Vercel: the api/socket-io.js entry point strips
# the /api/socket-io mount prefix before forwarding to Socket.IO. The frontend
# uses VITE_SOCKET_PATH=/api/socket-io/socket.io in production.
SOCKET_PATH=/socket.io
QUESTION_TIMEOUT_MS=60000
REVEAL_DELAY_MS=4000
# local = in-process timers, vercel = durable Vercel Queues jobs.
# On Vercel this is auto-detected via VERCEL=1, but setting it explicitly is
# recommended so the intent is visible in project settings.
QUEUE_DRIVER=local
# Signs Vercel Queues messages so the public /api/queue callback cannot be
# abused by third parties. Optional: CLERK_SECRET_KEY is used when unset.
QUEUE_SIGNING_SECRET=

CLERK_SECRET_KEY=
ADMIN_EMAIL=admin@example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
